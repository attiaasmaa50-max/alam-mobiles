let cart=[],currentFilter="all";
const fmt=n=>n.toLocaleString("en-US")+" ج.م";
function card(p,i){return `<article class="product"><div class="productPhoto" onclick="openDetail(${i})"><img src="${p.img}" alt="صورة توضيحية لهاتف ${p.name}" loading="lazy"><span class="tag">${p.tag}</span></div><div class="productInfo"><div class="brandname">${p.brand}</div><h3>${p.name}</h3><div class="specShort">${p.spec}</div><div class="price">${fmt(p.price)}</div><div class="productActions"><button class="add" onclick="add(${i})">أضف للسلة</button><button class="detailsBtn" title="التفاصيل" onclick="openDetail(${i})">↗</button></div></div></article>`}
function showView(id){document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));document.getElementById(id).classList.add("active");window.scrollTo({top:0,behavior:"smooth"})}
function showHome(){showView("homeView")}
function showCategories(){showView("categoriesView")}
function showProducts(filter){currentFilter=filter;document.getElementById("search").value="";document.getElementById("productHeading").textContent=filter==="all"?"كل الموبايلات":filter==="Apple"?"موبايلات Apple iPhone":filter==="Samsung"?"موبايلات Samsung":"ماركات متنوعة";showView("productsView");renderProducts()}
function matches(p,q){let group=currentFilter==="all"||(currentFilter==="Apple"&&p.brand==="Apple")||(currentFilter==="Samsung"&&p.brand==="Samsung")||(currentFilter==="other"&&!["Apple","Samsung"].includes(p.brand));return group&&(!q||(p.name+" "+p.brand+" "+p.spec).toLowerCase().includes(q.toLowerCase()))}
function renderProducts(){let q=document.getElementById("search").value.trim();let arr=products.map((p,i)=>({p,i})).filter(x=>matches(x.p,q));document.getElementById("productGrid").innerHTML=arr.map(x=>card(x.p,x.i)).join("");document.getElementById("empty").style.display=arr.length?"none":"block"}
function renderFeatured(){document.getElementById("featuredGrid").innerHTML=[0,4,6,12].map(i=>card(products[i],i)).join("")}
function add(i){cart.push(i);updateCart();toast("اتضاف المنتج للسلة بنجاح")}
function updateCart(){document.getElementById("cartCount").textContent=cart.length}
function toast(msg){let e=document.createElement("div");e.className="toast";e.textContent=msg;document.body.appendChild(e);setTimeout(()=>e.remove(),1900)}
function openDetail(i){let p=products[i];document.getElementById("modalBox").innerHTML=`<button class="close" onclick="closeModal()">إغلاق ✕</button><div class="detail"><img src="${p.img}" alt="صورة توضيحية لهاتف ${p.name}"><div><div class="brandname">${p.brand}</div><h2>${p.name}</h2><p>${p.spec}</p><div class="specs"><div class="spec">الماركة: ${p.brand}</div><div class="spec">الذاكرة: ${p.ram}</div><div class="spec">الحالة: جديد (تأكيد التوفر مطلوب)</div><div class="spec">الطلب: عبر واتساب</div></div><div class="price">${fmt(p.price)}</div><p style="font-size:12px">الصورة توضيحية وقد لا تطابق لون أو نسخة الجهاز المعروضة. السعر والمواصفات يحتاجان تأكيدًا قبل البيع.</p><button class="btn primary" onclick="add(${i});closeModal()">🛒 أضف للسلة</button></div></div>`;document.getElementById("modal").classList.add("show")}
function openCart(){let h='<button class="close" onclick="closeModal()">إغلاق ✕</button><h2 style="clear:both;padding-top:10px">🛒 سلة المشتريات</h2>';if(!cart.length){h+='<p style="color:var(--muted)">السلة فاضية حاليًا. اختار موبايل وارجع هنا.</p><button class="btn primary" onclick="closeModal();showCategories()">تصفح الموبايلات</button>'}else{let total=0;cart.forEach((idx,pos)=>{let p=products[idx];total+=p.price;h+=`<div class="cartItem"><div><b>${p.name}</b><br><small>${fmt(p.price)}</small></div><div class="qty"><button onclick="removeItem(${pos})">حذف</button></div></div>`});h+=`<h3>الإجمالي: ${fmt(total)}</h3><p style="color:var(--muted);font-size:12px">التوفر والسعر النهائي يتم تأكيدهما عند التواصل.</p><button class="btn primary" onclick="sendOrder()">إرسال الطلب على واتساب</button>`}document.getElementById("modalBox").innerHTML=h;document.getElementById("modal").classList.add("show")}
function removeItem(pos){cart.splice(pos,1);updateCart();openCart()}
function sendOrder(){let total=cart.reduce((s,i)=>s+products[i].price,0);let message="طلب من متجر عالم الموبايل:%0A"+cart.map(i=>"• "+products[i].name+" — "+fmt(products[i].price)).join("%0A")+"%0Aالإجمالي: "+fmt(total);window.open("https://wa.me/201028889323?text="+message,"_blank")}
function closeModal(){document.getElementById("modal").classList.remove("show")}
document.getElementById("modal").addEventListener("click",e=>{if(e.target.id==="modal")closeModal()});
renderFeatured();updateCart();
</script></body></html>
